# Copie para .env e troque as senhas: cp .env.example .env
# O .env fica fora do Git.

MYSQL_DATABASE=enem
MYSQL_USER=enem
MYSQL_PASSWORD=troque_esta_senha
MYSQL_ROOT_PASSWORD=troque_esta_senha_root

# Pasta do host onde ficam o zip, o CSV e os arquivos intermediários.
# No Codespaces, use /tmp/enem-data: o disco de /tmp é maior que o do projeto.
DATA_DIR_HOST=./data
